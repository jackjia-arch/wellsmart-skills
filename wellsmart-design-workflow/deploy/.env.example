# copy to .env — the ONLY secrets in the system; employees never see them
WS_REVIEWER_PROVIDER=openai            # openai | openai-compatible | gemini | mock (mock = test without a key)
WS_REVIEWER_MODEL=gpt-5                # the reviewer model (a different family from the designer)
OPENAI_API_KEY=sk-...                  # or GEMINI_API_KEY=...
WS_BOOK_BASE_URL=https://books.example.com   # public base of the project books (Cloudflare Tunnel hostname)
CLOUDFLARE_TUNNEL_TOKEN=eyJ...         # from the Cloudflare Zero Trust dashboard: Networks → Tunnels → create → token
LIBRARY_PATH=/srv/library              # optional: checkout of wellsmart-design-library (gen_book.py, checks)
PRIVATE_PROJECTS=                     # comma-separated project folder names that must NOT get a public book
POLL=30
