# /etc/systemd/system/rclone-mount.service — mounts the company Drive folder "Projects" at /srv/projects.
# One-time: rclone config → new remote "gdrive" (Google Drive, company account or a service account with the
# shared drive), then: sudo systemctl enable --now rclone-mount
[Unit]
Description=rclone mount of the shared Projects drive
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=/bin/mkdir -p /srv/projects
ExecStart=/usr/bin/rclone mount gdrive:Projects /srv/projects \
  --vfs-cache-mode full --vfs-cache-max-age 24h --dir-cache-time 30s --poll-interval 30s \
  --allow-other --umask 002 --log-level INFO --log-file /var/log/rclone-mount.log
ExecStop=/bin/fusermount -uz /srv/projects
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
